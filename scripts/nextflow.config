singularity.enabled = true
singularity.autoMounts = true
nextflowVersion = '>=21.04.1'

params.system = "gl"
	
process {
	containerOptions = '-B /gpfs,/scratch'
	executor = 'slurm'
	errorStrategy = 'finish'
	clusterOptions = ' --account=scjp1 '
	time = '50h'
	memory = '8 GB'
	cpus = 1
	stageInMode = "rellink"
}

//
// set paths for generic files here
// Fire up a singularity shell using the path to rstudio.sif and then you can install stuff in there
// or just run stuff from mamba and remove the container flag from the nextflow process
	
params {
	email = "kgmoo@umich.edu"
	results = "results"
	basedir = "/nfs/turbo/umms-scjp/kgmoo/analysis/20250428_kgmoo_ATACge/"
}
// containers from Arushi, just using a mamba environment at the moment
//container_glmm = "/nfs/turbo/umms-scjp/kgmoo/analysis/20250428_kgmoo_ATACge/data/rstudio.sif"
//container_general = "/nfs/turbo/umms-scjp/kgmoo/analysis/20250428_kgmoo_ATACge/data/general.simg"